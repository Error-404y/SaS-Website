SAS_HOST=0.0.0.0
SAS_ADMIN_USERNAME=admin
SAS_ADMIN_PASSWORD=
SAS_DB_PATH=/home/container/data/website.sqlite3
SAS_COOKIE_SECURE=1
SAS_DISCORD_WEBHOOK_URL=
# New account registration requests (admin reminder only)
SAS_DISCORD_REGISTRATION_WEBHOOK_URL=
# Successful sign-ins from members and administrators
SAS_DISCORD_LOGIN_WEBHOOK_URL=

# true: display Under Construction only, disable all logins and APIs
# false: normal website and account access
Const-Web=false
